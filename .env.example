APP_ENV=development
APP_URL=http://localhost
APP_TIMEZONE=America/New_York
SESSION_NAME=britescheduler

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=britescheduler
DB_USER=britescheduler
DB_PASS=change-me

# Enrollment is fail-closed until all settings below are configured.
# Use a long random secret; do not commit the real value.
ENROLLMENT_RATE_SECRET=
ENROLLMENT_MAIL_FROM=
ENROLLMENT_TERMS_URL=
ENROLLMENT_PRIVACY_URL=
ENROLLMENT_TERMS_VERSION=
ENROLLMENT_PRIVACY_VERSION=

# Base64-encoded 32-byte random key for encrypted queued verification emails.
# Generate locally: php -r 'echo base64_encode(random_bytes(32)), PHP_EOL;'
ENROLLMENT_OUTBOX_KEY=

# Contractor document vault: create private directory outside the application webroot.
# Use a DIFFERENT base64-encoded 32-byte key than ENROLLMENT_OUTBOX_KEY.
ENROLLMENT_DOCUMENT_ROOT=
ENROLLMENT_DOCUMENT_KEY=
# Absolute public web document root; vault must be outside this directory.
ENROLLMENT_WEB_ROOT=

# Required for contractor document uploads; absolute path to trusted ClamAV clamscan executable
ENROLLMENT_CLAMSCAN_BIN=
