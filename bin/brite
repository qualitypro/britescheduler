#!/usr/bin/env php
<?php
declare(strict_types=1);

$root = dirname(__DIR__);
require_once $root . '/app/Installation/RequirementsChecker.php';
require_once $root . '/app/Installation/MigrationInventory.php';
require_once $root . '/app/Installation/InstallationStatus.php';

use BriteScheduler\Installation\RequirementsChecker;
use BriteScheduler\Installation\MigrationInventory;
use BriteScheduler\Installation\InstallationStatus;

$command = $argv[1] ?? 'help';
if ($command === 'help' || $command === '--help') {
    echo "Brite Scheduler setup tools\n";
    echo "  php bin/brite doctor       Read-only PHP and filesystem diagnostics\n";
    echo "  php bin/brite migrations  Read-only ordered SQL migration inventory\n";
    echo "  php bin/brite status       Read-only database migration status (no secrets)\n";
    echo "  php bin/brite mail:send   Deliver pending enrollment email (CLI only)\n";
    echo "  php bin/brite mail:status Read-only delivery counts and stale claims\n";
    echo "Installation and migration execution are not yet enabled.\n";
    exit(0);
}
if ($command === 'doctor') {
    $checks = RequirementsChecker::inspect($root);
    $failed = false;
    foreach ($checks as $name => $check) {
        echo ($check['ok'] ? '[PASS] ' : '[FAIL] ') . $name . ': ' . $check['detail'] . PHP_EOL;
        $failed = $failed || !$check['ok'];
    }
    exit($failed ? 1 : 0);
}
if ($command === 'migrations') {
    foreach (MigrationInventory::list($root) as $migration) {
        echo $migration['version'] . '  sha256:' . $migration['sha256'] . PHP_EOL;
    }
    exit(0);
}
if ($command === 'mail:status') {
    require_once $root . '/app/bootstrap.php';
    require_once $root . '/app/Registration/OutboxStatus.php';
    try {
        $status = \BriteScheduler\Registration\OutboxStatus::inspect(Database::connection());
        foreach ($status['counts'] as $name => $count) {
            echo $name . ': ' . $count . PHP_EOL;
        }
        echo 'stale sending claims: ' . $status['stale_claims'] . PHP_EOL;
        exit($status['stale_claims'] > 0 ? 1 : 0);
    } catch (Throwable $error) {
        fwrite(STDERR, "Unable to inspect enrollment email delivery.\n");
        exit(1);
    }
}
if ($command === 'mail:send') {
    require_once $root . '/app/bootstrap.php';
    require_once $root . '/app/Registration/EmailEnvelope.php';
    require_once $root . '/app/Registration/OutboxWorker.php';
    try {
        $result = \BriteScheduler\Registration\OutboxWorker::run(Database::connection());
        echo 'Email accepted by transport: ' . $result['sent'] . PHP_EOL;
        echo 'Email attempts failed: ' . $result['failed'] . PHP_EOL;
        exit($result['failed'] ? 1 : 0);
    } catch (Throwable $error) {
        fwrite(STDERR, "Mail worker unavailable. Check configuration, database migrations, and transport.\n");
        exit(1);
    }
}
if ($command === 'status') {
    require_once $root . '/app/bootstrap.php';
    try {
        $status = InstallationStatus::inspect($root, Database::connection());
        echo 'Installed migrations: ' . count($status['applied']) . PHP_EOL;
        echo 'Pending migrations: ' . count($status['pending']) . PHP_EOL;
        foreach ($status['pending'] as $migration) {
            echo '[PENDING] ' . $migration['version'] . PHP_EOL;
        }
        foreach ($status['unknown'] as $version) {
            echo '[UNKNOWN] ' . $version . PHP_EOL;
        }
        exit(count($status['unknown']) ? 1 : 0);
    } catch (Throwable $error) {
        fwrite(STDERR, "Unable to inspect migration status. Verify database configuration.\n");
        exit(1);
    }
}
fwrite(STDERR, "Unknown or unavailable command. Run: php bin/brite help\n");
exit(2);
